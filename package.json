{
  "name": "next-starter-designkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/copy-bootstrap.js && next build",
    "start": "next start",
    "lint": "biome check --formatter-enabled=false --assist-enabled=false",
    "format": "biome format --write",
    "codegen": "graphql-codegen --config codegen.ts",
    "a11y:templates": "cd a11y && rm -rf reports && playwright test tests/templates.spec.ts",
    "a11y:full": "cd a11y && rm -rf reports && playwright test tests/full.spec.ts --project=desktop",
    "a11y:report": "cd a11y && node lib/report.ts",
    "postinstall": "node scripts/copy-bootstrap.js"
  },
  "dependencies": {
    "@datocms/cda-client": "0.3.2",
    "@datocms/cma-client": "4.0.2",
    "@types/react-google-recaptcha": "2.1.9",
    "algoliasearch": "5.65.0",
    "bootstrap-italia": "2.18.3",
    "csrf": "3.1.0",
    "dataviz-components": "0.2.27",
    "datocms-structured-text-to-plain-text": "5.1.16",
    "design-react-kit": "5.11.0",
    "dotenv": "16.6.1",
    "graphql": "16.15.0",
    "iron-session": "8.0.4",
    "jose": "6.2.18",
    "jsforce": "3.13.4",
    "jwt-decode": "4.0.0",
    "next": "16.4.6",
    "nodemailer": "10.6.1",
    "react": "19.3.1",
    "react-datocms": "7.2.14",
    "react-dom": "19.3.1",
    "react-google-recaptcha": "3.1.0",
    "react-google-recaptcha-v3": "1.11.0",
    "react-instantsearch": "7.55.1",
    "redis": "5.12.4",
    "uuid": "13.0.2",
    "zod": "4.6.7"
  },
  "engines": {
    "node": "26.x"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.9",
    "@graphql-codegen/cli": "8.0.0",
    "@graphql-codegen/typed-document-node": "8.0.0",
    "@graphql-codegen/typescript": "7.0.1",
    "@graphql-codegen/typescript-operations": "7.0.2",
    "@graphql-typed-document-node/core": "3.2.0",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "classnames": "2.5.1",
    "sass": "1.108.2",
    "typescript": "7.0.2"
  },
  "volta": {
    "node": "26.13.1"
  }
}
